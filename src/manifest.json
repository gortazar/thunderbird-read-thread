{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "author": "Patxi Gortázar",
  "homepage_url": "https://github.com/gortazar/thunderbird-read-thread",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "sent-in-threads@gortazar.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "compose",
    "menus",
    "notifications",
    "storage"
  ]
}
